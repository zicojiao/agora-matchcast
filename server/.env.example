AGORA_APP_ID=
AGORA_APP_CERTIFICATE=
AGORA_AREA_CODE=global
TRANSCRIBER_UID=123456
MEDIA_UID=234567

# Use a key whose Google Cloud project has access to Gemini 3.5 Transcribe.
GEMINI_API_KEY=
# Gemini 3.5 Transcribe Live model used by the backend.
GEMINI_MODEL=models/gemini-3.5-transcribe-live
GEMINI_TRANSCRIBE_MODEL=models/gemini-3.5-transcribe-live
GEMINI_LANGUAGE=en-US
# Smart mode removes disfluencies and formats captions for readability.
# Use verbatim for literal transcripts and controlled benchmarks.
GEMINI_TRANSCRIPTION_MODE=smart
# Set `none` to send no custom vocabulary.
GEMINI_VOCABULARY_MODE=custom
# Optional comma-separated additions to the built-in vocabulary.
GEMINI_VOCABULARY=Hextech Soul,Gen.G
# Dedicated Gemini Transcribe uses a separate compact list to avoid vocabulary
# hallucinations. An explicit list replaces its built-in ten-term preset.
GEMINI_TRANSCRIBE_VOCABULARY=
GEMINI_TRANSCRIBE_ACTIVITY_MIN_MS=5000
GEMINI_TRANSCRIBE_ACTIVITY_MAX_MS=6000
GEMINI_TRANSCRIBE_ACTIVITY_PREFIX_MS=300
GEMINI_TRANSCRIBE_ACTIVITY_LOW_ENERGY_RATIO=0.5
GEMINI_TRANSCRIBE_ACTIVITY_COMMIT_GRACE_SECONDS=0.9
# Wait briefly for the previous activity's final before sending the next one.
# Set to 0 to restore the old immediate-restart behavior.
GEMINI_TRANSCRIBE_ACTIVITY_HANDOFF_SECONDS=1.5
GEMINI_TRANSCRIBE_ACTIVITY_BUFFER_MAX_MS=3000

# Keep sessions bounded below the configured provider limits.
LIVE_SESSION_MAX_SECONDS=540
VIEWER_HEARTBEAT_TIMEOUT_SECONDS=45

# Disabled by default. Set a local path to capture exactly the normalized
# 16 kHz mono PCM that the backend sends to Gemini.
TRANSCRIPTION_PCM_CAPTURE_PATH=
TRANSCRIPTION_PCM_CAPTURE_MAX_SECONDS=60

# Must match the frontend environment when configured.
BACKEND_API_SECRET=
