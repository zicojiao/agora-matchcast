# Agora Web SDK and token route
NEXT_PUBLIC_AGORA_APP_ID=
NEXT_AGORA_APP_CERTIFICATE=
NEXT_PUBLIC_LIVE_CHANNEL_NAME=matchcast-live
NEXT_PUBLIC_AGENT_UID=123456
NEXT_PUBLIC_MATCH_FEED_UID=234567

# Optional restricted showcase mode. When true, the UI and start route expose
# only transcribers marked public in lib/transcribers.ts.
NEXT_PUBLIC_PUBLIC_DEMO_MODE=false

# Backend models and credentials are configured in server/.env.local.

# Next.js → Python backend
AGENT_BACKEND_URL=http://localhost:8000
BACKEND_API_SECRET=

# Used only by the Media Gateway helper
AGORA_CUSTOMER_ID=
AGORA_CUSTOMER_SECRET=
AGORA_MEDIA_GATEWAY_REGION=
AGORA_MEDIA_GATEWAY_STREAM_KEY_TTL=2592000
